# Multi-AI Bridge

BRIDGE_PORT=8080
BRIDGE_API_KEY=
DATABASE_PATH=/data/bridge.db

NEXT_PUBLIC_BRIDGE_URL=http://localhost:8080
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# ── Provider keys (use any combination) ──
# OpenRouter is recommended: one key unlocks many models
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Optional direct keys (used if you prefer not to go through OpenRouter)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=

# Default model when an agent does not specify one (OpenRouter model id)
DEFAULT_MODEL=anthropic/claude-sonnet-4
