# === API host (Render / Railway / Fly) ===
BRIDGE_PORT=8080
DATABASE_PATH=/data/bridge.db
BRIDGE_API_KEY=change-me-long-secret

# === LLM runners (local or private worker) ===
OPENROUTER_API_KEY=
# Optional alternatives:
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=
# XAI_API_KEY=
DEFAULT_MODEL=anthropic/claude-sonnet-4

# === UI (Vercel) — server-side ===
# BRIDGE_URL=https://YOUR-API.onrender.com
# BRIDGE_API_KEY=same-as-api
# NEXT_PUBLIC_WS_URL=wss://YOUR-API.onrender.com/ws
